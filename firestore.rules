rules_version = '2';

// Green Basket Firestore Security Rules.
// The browser talks to Firestore directly, so these rules ARE the backend's
// authorization layer. See docs/FIREBASE.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Phone numbers (E.164) granted ADMIN regardless of their stored role.
    // Keep in sync with ADMIN_PHONES in src/lib/api/firebase.ts. Phone is now
    // the ONLY sign-in method app-wide (Google sign-in was removed), so this
    // replaces the old email-based allowlist.
    //
    // A phone-auth token always carries `phone_number`, but guard with `in`
    // anyway (safe presence check, never errors) — the same defensive
    // pattern as userRole() below, in case a future auth method's token ever
    // lacks it.
    function isAdminPhone() {
      return isSignedIn()
             && 'phone_number' in request.auth.token
             && request.auth.token.phone_number in ['+919700144003'];
    }

    // Reading `.data` off a get() for a document that doesn't exist throws —
    // and an error anywhere in a rule evaluation is treated as an automatic
    // deny for the WHOLE rule, not just this check. So any signed-in user
    // whose users/{uid} doc is missing (incomplete onboarding, deleted
    // profile, any other edge case) would get "Missing or insufficient
    // permissions" on every single write, including their own orders —
    // isAdmin() is evaluated first in nearly every allow clause in this
    // file. Guard with exists() so a missing profile just resolves to "not
    // admin" instead of blowing up the whole request.
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : null;
    }

    function isAdmin() {
      return isAdminPhone() || (isSignedIn() && userRole() == 'ADMIN');
    }

    // Delivery executives. They see and touch ONLY the orders assigned to
    // them — never the catalog, never another driver's run, never a buyer's
    // profile.
    function isDriver() {
      return isSignedIn() && userRole() == 'DRIVER';
    }

    // Only the `stock` field is being changed.
    function onlyStockChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    // --- Settings: daily price-update gate. World-readable; admin-writable. ---
    match /settings/dailyPrices {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // --- Settings: admin store-open override ({ override, expiresAt, ... }).
    //     World-readable because every buyer's shop screen needs it to decide
    //     whether the store is live; admin-writable only. Deliberately allows
    //     delete so an admin can clear the override entirely, which the app
    //     reads as AUTO. ---
    match /settings/store {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Settings: delivery service area ({ hub, radiusKm, pincodes }).
    //     World-readable — the driver app sequences a run from it, and
    //     where we deliver is not a secret. Admin-writable only. ---
    match /settings/serviceArea {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // --- Settings: live price mirror ({ prices: {...}, minQty: {...} }),
    //     kept in sync by updateProduct/createProduct/updateProductPrices in
    //     src/lib/api/firebase.ts on every price-changing admin write. The
    //     order-create rule reads this ONE document instead of doing a
    //     get() per line item — that's what lets a cart carry any number of
    //     distinct products instead of being capped by Firestore's
    //     get()-call budget per rule evaluation. World-readable (prices are
    //     already public via the products catalog); admin-writable only.
    //     `minQty` carries each product's wholesale minimum, so the
    //     order-create rule can enforce it from this same single get().
    match /settings/priceSheet {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Signed-in buyers reserve/release stock during order/cancel transactions.
    // The change must only touch `stock` and may move by at most 10,000 units
    // (either direction) — generous headroom above any realistic single bulk
    // B2B order, while still blocking a wildly out-of-range write. (This was
    // previously capped at 500, which a legitimate bulk order could exceed on
    // its own — e.g. ordering 550kg of an item seeded with 600kg of stock —
    // failing the whole checkout with "Missing or insufficient permissions".)
    function isStockChangeValid() {
      return request.resource.data.stock >= 0
             && request.resource.data.stock <= resource.data.stock + 10000
             && request.resource.data.stock >= resource.data.stock - 10000;
    }

    // ORDER VALIDATION AND THE READ BUDGET.
    //
    // Rules functions are macros, not calls: every reference to a get() is
    // re-evaluated where it appears. Checkout writes a stock decrement per
    // line PLUS the order in one transaction, and a transaction gets 20
    // document reads across all its rule evaluations — so comparing each
    // line's price against settings/priceSheet cost reads that grew with the
    // cart. It ran out at FOUR items and every larger cart died as "Missing
    // or insufficient permissions", which is what a live customer hit.
    // Measured against the Firestore emulator, largest cart that worked:
    //
    //   per-item price + subtotal + weight ...  3
    //   subtotal + weight (this file) ........ 27
    //   subtotal only ........................ 50
    //
    // Per-item price-to-catalogue validation therefore moves to the server,
    // which reads the catalogue once instead of once per line. What stays
    // here is everything that costs no read: the subtotal must equal the sum
    // of the lines, the fee must follow from the subtotal, the total must
    // follow from both, the cart must be within the item and weight caps, it
    // must be the buyer's own, and it cannot be self-marked PAID. The item
    // cap is 25 rather than 50 so a buyer is told plainly when a cart is too
    // large, instead of meeting an opaque denial at 28.

    // Delivery fee slab based on subtotal (in rupees).
    // Mirrors calculateDeliveryFee() in src/lib/delivery.ts — keep in
    // lockstep, or every checkout is denied.
    function getExpectedDeliveryFee(subtotal) {
      return subtotal <= 0 ? 0 :
             subtotal < 1000 ? 50 :
             subtotal <= 3000 ? 25 :
             0;
    }

    // Expected subtotal = Σ (catalogue price × qty), read from the ONE
    // settings/priceSheet mirror — a SINGLE get(), independent of cart size.
    //
    // This is emphatically NOT the per-line price read that once blew the
    // 20-read transaction budget and failed every checkout past ~4 items (the
    // reason per-item price validation was pulled out before). That grew one
    // get() per cart line; this reads one document, once, however big the cart.
    // The mirror is kept COMPLETE for exactly this: publishDailyPrices rebuilds
    // it from the whole catalogue, and createProduct adds each new product, so
    // every orderable product is always present and this never wrongly denies.
    //
    // A FLAT 50-slot guarded sum, not a chunked size-branch ladder: the engine
    // counts every branch of a ternary ladder toward its 1000-sub-expression
    // cap, so the branched shape overflowed it; a flat sum of guarded slots is
    // counted once and clears the cap up to the create rule's item ceiling.
    // The old ≤500-unit weight ladder was dropped to make room — it was
    // logistics, never security, and a large order is now CHARGED in full at
    // catalogue prices rather than stolen (the client still soft-caps weight).
    function getExpectedSubtotal(items, prices) {
      return (0 < items.size() ? prices[items[0].productId] * items[0].qty : 0)
           + (1 < items.size() ? prices[items[1].productId] * items[1].qty : 0)
           + (2 < items.size() ? prices[items[2].productId] * items[2].qty : 0)
           + (3 < items.size() ? prices[items[3].productId] * items[3].qty : 0)
           + (4 < items.size() ? prices[items[4].productId] * items[4].qty : 0)
           + (5 < items.size() ? prices[items[5].productId] * items[5].qty : 0)
           + (6 < items.size() ? prices[items[6].productId] * items[6].qty : 0)
           + (7 < items.size() ? prices[items[7].productId] * items[7].qty : 0)
           + (8 < items.size() ? prices[items[8].productId] * items[8].qty : 0)
           + (9 < items.size() ? prices[items[9].productId] * items[9].qty : 0)
           + (10 < items.size() ? prices[items[10].productId] * items[10].qty : 0)
           + (11 < items.size() ? prices[items[11].productId] * items[11].qty : 0)
           + (12 < items.size() ? prices[items[12].productId] * items[12].qty : 0)
           + (13 < items.size() ? prices[items[13].productId] * items[13].qty : 0)
           + (14 < items.size() ? prices[items[14].productId] * items[14].qty : 0)
           + (15 < items.size() ? prices[items[15].productId] * items[15].qty : 0)
           + (16 < items.size() ? prices[items[16].productId] * items[16].qty : 0)
           + (17 < items.size() ? prices[items[17].productId] * items[17].qty : 0)
           + (18 < items.size() ? prices[items[18].productId] * items[18].qty : 0)
           + (19 < items.size() ? prices[items[19].productId] * items[19].qty : 0)
           + (20 < items.size() ? prices[items[20].productId] * items[20].qty : 0)
           + (21 < items.size() ? prices[items[21].productId] * items[21].qty : 0)
           + (22 < items.size() ? prices[items[22].productId] * items[22].qty : 0)
           + (23 < items.size() ? prices[items[23].productId] * items[23].qty : 0)
           + (24 < items.size() ? prices[items[24].productId] * items[24].qty : 0)
           + (25 < items.size() ? prices[items[25].productId] * items[25].qty : 0)
           + (26 < items.size() ? prices[items[26].productId] * items[26].qty : 0)
           + (27 < items.size() ? prices[items[27].productId] * items[27].qty : 0)
           + (28 < items.size() ? prices[items[28].productId] * items[28].qty : 0)
           + (29 < items.size() ? prices[items[29].productId] * items[29].qty : 0)
           + (30 < items.size() ? prices[items[30].productId] * items[30].qty : 0)
           + (31 < items.size() ? prices[items[31].productId] * items[31].qty : 0)
           + (32 < items.size() ? prices[items[32].productId] * items[32].qty : 0)
           + (33 < items.size() ? prices[items[33].productId] * items[33].qty : 0)
           + (34 < items.size() ? prices[items[34].productId] * items[34].qty : 0)
           + (35 < items.size() ? prices[items[35].productId] * items[35].qty : 0)
           + (36 < items.size() ? prices[items[36].productId] * items[36].qty : 0)
           + (37 < items.size() ? prices[items[37].productId] * items[37].qty : 0)
           + (38 < items.size() ? prices[items[38].productId] * items[38].qty : 0)
           + (39 < items.size() ? prices[items[39].productId] * items[39].qty : 0)
           + (40 < items.size() ? prices[items[40].productId] * items[40].qty : 0)
           + (41 < items.size() ? prices[items[41].productId] * items[41].qty : 0)
           + (42 < items.size() ? prices[items[42].productId] * items[42].qty : 0)
           + (43 < items.size() ? prices[items[43].productId] * items[43].qty : 0)
           + (44 < items.size() ? prices[items[44].productId] * items[44].qty : 0)
           + (45 < items.size() ? prices[items[45].productId] * items[45].qty : 0)
           + (46 < items.size() ? prices[items[46].productId] * items[46].qty : 0)
           + (47 < items.size() ? prices[items[47].productId] * items[47].qty : 0)
           + (48 < items.size() ? prices[items[48].productId] * items[48].qty : 0)
           + (49 < items.size() ? prices[items[49].productId] * items[49].qty : 0);
    }

    // Allowed top-level fields on a new order document. Prevents buyers from
    // injecting arbitrary keys (e.g. `isAdmin`, `discount`, `refundAmount`)
    // into the order document.
    function hasOnlyOrderFields() {
      return request.resource.data.keys().hasOnly([
        'buyerId', 'businessName', 'items', 'status', 'paymentMethod',
        'paymentStatus', 'subtotal', 'deliveryFee', 'total', 'delivery',
        'createdAt', 'updatedAt', 'orderNumber', 'deliveredAt'
      ]);
    }

    // Buyer cancel: only the `status`, `updatedAt`, and `notes` fields may change.
    function onlyCancelFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'notes']);
    }

    // --- Products: public catalog. Admins manage; signed-in users may only
    //     adjust stock (order/cancel transactions). ---
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // ORDER MATTERS. isAdmin() costs exists()+get() on users/{uid} — two of
      // the 20 document reads a transaction is allowed. Checkout decrements
      // stock on every line in ONE transaction, so with isAdmin() first a
      // 10-item cart spent 20 reads before the order was even looked at and
      // every checkout died as "Missing or insufficient permissions". CEL
      // short-circuits, so putting the read-free buyer branch first costs a
      // buyer nothing; an admin simply falls through to isAdmin().
      allow update: if (isSignedIn() && onlyStockChanged() && isStockChangeValid())
                       || isAdmin();
    }

    // --- Coupons: public promo codes, admin-managed. World-readable so any
    //     buyer sees active codes (e.g. on the order-success screen);
    //     writes are admin-only. ---
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- In-app notifications: a buyer's own history, plus admin read/delete
    //     for the "Wipe DB" reset button (bulk-deletes every buyer's
    //     notifications, not just the admin's own). ---
    match /notifications/{notifId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
    }

    // --- Users: a user reads/edits their own profile; admins read all.
    //     Self-signup may only create a BUYER and cannot self-promote. ---
    // Only these fields may appear on a user document — blocks a buyer from
    // injecting trust-looking keys (credit, wallet, disabled, isAdmin, …) onto
    // their own profile, which nothing reads today but would be a latent
    // privilege/credit footgun the moment any code did.
    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'role', 'businessName', 'businessType',
        'city', 'address', 'pincode', 'lat', 'lng', 'addressLabel', 'gstin',
        'createdAt', 'cart', 'theme', 'lang', 'pinnedTiles', 'disabled'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && hasOnlyUserFields()
                    && (request.resource.data.role == 'BUYER' || isAdminPhone());
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && hasOnlyUserFields()
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // --- Legacy email/phone uniqueness-claim docs from before phone became
    //     the sole sign-in method. Firebase phone auth already guarantees at
    //     most one account per verified number, so nothing writes to these
    //     collections anymore — kept admin-readable/deletable only so the
    //     "Wipe DB" button can sweep out any docs left over from before this
    //     change. No buyer ever needs (or gets) access to these.
    match /emailIndex/{email} {
      allow get, list, delete: if isAdmin();
      allow create, update: if false;
    }
    match /phoneIndex/{phone} {
      allow get, list, delete: if isAdmin();
      allow create, update: if false;
    }

    // Allowed top-level fields on a new support ticket document.
    function hasOnlySupportTicketFields() {
      return request.resource.data.keys().hasOnly([
        'buyerId', 'businessName', 'buyerPhone', 'status', 'needsHuman',
        'thread', 'createdAt', 'updatedAt', 'closedAt'
      ]);
    }

    // Buyer reply / escalation: only thread, updatedAt, and needsHuman may
    // change, and the thread must grow by exactly one message.
    function isBuyerTicketReply() {
      return resource.data.buyerId == request.auth.uid
             && resource.data.status == 'OPEN'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'updatedAt', 'needsHuman'])
             && request.resource.data.thread.size() == resource.data.thread.size() + 1
             // The new message must be the buyer's own — stops a buyer forging
             // a message tagged sender:'admin' into their own thread.
             && request.resource.data.thread[resource.data.thread.size()].sender == 'buyer';
    }

    // Buyer ends their own open ticket — status flips to CLOSED and nothing
    // else changes besides the close timestamps.
    function isBuyerTicketClose() {
      return resource.data.buyerId == request.auth.uid
             && resource.data.status == 'OPEN'
             && request.resource.data.status == 'CLOSED'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'closedAt']);
    }

    // Self-expiring "is typing" heartbeat (see lib/typing-indicator.ts).
    function isBuyerTicketTyping() {
      return resource.data.buyerId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyerTypingAt']);
    }

    // --- Support tickets: buyer creates/reads/replies/closes their own; admins manage all. ---
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'OPEN'
                    && hasOnlySupportTicketFields()
                    && request.resource.data.thread.size() <= 1;

      allow update: if isAdmin()
                    || isBuyerTicketReply()
                    || isBuyerTicketClose()
                    || isBuyerTicketTyping();

      allow delete: if isAdmin();
    }

    // --- Orders: a buyer creates/reads/cancels their own; admins manage all. ---
    // The driver running this order. Scoped by assignment, so a driver can
    // only ever see and touch their own run.
    function isAssignedDriver() {
      return isDriver() && resource.data.driverId == request.auth.uid;
    }

    // What a driver may change at the door: record the buyer's rejection,
    // take the cash, and close the delivery. Deliberately narrow — items,
    // totals and buyerId stay untouchable, so a driver can reduce what is
    // collected only through an `adjustment` that carries photo evidence and
    // is auditable after the fact.
    function isDriverDoorstepUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['adjustment', 'status', 'paymentStatus', 'deliveredAt', 'updatedAt', 'notes'])
             // Assigning a driver does NOT move the order to SHIPPED, so a run
             // routinely goes out with orders still CONFIRMED or PACKED. If
             // this only accepted SHIPPED/DELIVERED, the very first write at
             // the door — recording a rejection, which leaves status alone —
             // would be denied as "missing permissions" with the customer
             // standing there. PENDING and CANCELLED stay out: a driver must
             // not be able to push an order backwards or revive a dead one.
             && request.resource.data.status in ['CONFIRMED', 'PACKED', 'SHIPPED', 'DELIVERED']
             && request.resource.data.buyerId == resource.data.buyerId
             && request.resource.data.total == resource.data.total
             && request.resource.data.items == resource.data.items
             // A refund the driver WRITES must either escalate (PENDING, an
             // admin settles it) or sit within the driver's own authority —
             // max(₹500, 10% of the order). Without this a driver could write
             // an AUTO_APPROVED full-value refund and hand over the goods for
             // nothing. Only checked when this write actually changes the
             // adjustment, so recording a delivery on an admin-approved order
             // is unaffected. The *10 <= total+10 form avoids a float-rounding
             // mismatch against the client's Math.round(total*0.1).
             && (!('adjustment' in request.resource.data.diff(resource.data).affectedKeys())
                 || request.resource.data.adjustment.status == 'PENDING'
                 || (request.resource.data.adjustment.status == 'AUTO_APPROVED'
                     && (request.resource.data.adjustment.totalRefund <= 500
                         || request.resource.data.adjustment.totalRefund * 10 <= resource.data.total + 10)));
    }

    // A driver handing a stop back: shop shut, nobody there, gate locked. He
    // takes himself off the order and it returns to the office's unassigned
    // queue, so he can move on instead of stalling the whole run at a closed
    // shutter. Narrow on purpose — status, money and items are untouchable,
    // the driver fields must end up GONE rather than pointed at someone else,
    // and an order already delivered can't be handed back. `notes` carries
    // who gave it up and why, which is the only record of the attempt.
    function isDriverReleaseUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['driverId', 'driverName', 'assignedAt', 'deliveryDate', 'notes', 'updatedAt'])
             && !('driverId' in request.resource.data)
             && !('deliveryDate' in request.resource.data)
             && resource.data.status != 'DELIVERED'
             && request.resource.data.status == resource.data.status
             && request.resource.data.buyerId == resource.data.buyerId
             && request.resource.data.total == resource.data.total
             && request.resource.data.items == resource.data.items;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn()
                  && (resource.data.buyerId == request.auth.uid
                      || isAdmin()
                      || isAssignedDriver());
      // Buyers create their own auto-confirmed orders; admins (POS / phone desk) may
      // place an order on behalf of any buyer. Field whitelist prevents
      // injection of arbitrary keys (e.g. `discount`, `isAdmin`).
      // Buyer branch FIRST, for the same read-budget reason as the products
      // rule above: isAdmin() costs two document reads, and this create shares
      // its 20-read budget with every stock decrement in the same checkout
      // transaction. An admin POS order fails the buyer branch harmlessly and
      // falls through to isAdmin().
      allow create: if (isSignedIn()
                        && hasOnlyOrderFields()
                        && request.resource.data.buyerId == request.auth.uid
                        && request.resource.data.status in ['CONFIRMED']
                        && request.resource.data.paymentMethod in ['COD', 'ONLINE']
                        // A buyer can never self-mark an order PAID — that
                        // flips only via an admin (cash collected) or a
                        // server-verified online payment. Without this a
                        // buyer could write paymentStatus:'PAID' and receive
                        // goods without paying.
                        && request.resource.data.paymentStatus == 'UNPAID'
                        && request.resource.data.items.size() > 0
                        && request.resource.data.items.size() <= 40
                        && request.resource.data.subtotal > 0
                        && request.resource.data.subtotal == getExpectedSubtotal(request.resource.data.items, get(/databases/$(database)/documents/settings/priceSheet).data.prices)
                        && request.resource.data.deliveryFee == getExpectedDeliveryFee(request.resource.data.subtotal)
                        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee)
                    || isAdmin();
      // Admin can advance to any status; a buyer may only cancel while the
      // order is still PENDING/CONFIRMED and may ONLY change `status`,
      // `updatedAt`, and `notes` (cannot tamper with items, totals, etc.).
      allow update: if isAdmin()
                    || (isAssignedDriver()
                        && (isDriverDoorstepUpdate() || isDriverReleaseUpdate()))
                    || (resource.data.buyerId == request.auth.uid
                        && resource.data.status in ['PENDING', 'CONFIRMED']
                        // Not once it is with a driver: the crates are on the
                        // van, and a buyer-side cancel would drop the stop off
                        // his run with nothing telling him why. The office can
                        // still cancel it (isAdmin above) and phone him.
                        && !('driverId' in resource.data)
                        && request.resource.data.status == 'CANCELLED'
                        && onlyCancelFieldsChanged());
      allow delete: if isAdmin();
    }
  }
}
