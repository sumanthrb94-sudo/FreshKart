# @capacitor-firebase/authentication declares an optional peer on firebase v12
# while this app is on v10. The conflict is only in the JS peer range: the
# plugin bridges to the native Android SDK, and the phone-auth credential
# exchange uses this project's own firebase v10 (see src/lib/firebase/phone-auth.ts).
# Installs must resolve the same way locally and on CI, so the flag lives here
# rather than in one developer's command line.
legacy-peer-deps=true
