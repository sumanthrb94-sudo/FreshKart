rules_version = '2';

// Green Basket Cloud Storage rules — product imagery + return photos.
// Products: public read (catalog images); only admins may upload/replace/delete.
// Returns: buyers upload damage photos under their own uid; any signed-in
// user (i.e. the buyer and admins) may view them.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /products/{imageId=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The returns feature was removed from the app (fresh produce is settled at
    // the door via delivery adjustments, not post-delivery returns), so nothing
    // uploads to or reads from returns/ any more. The rule block is deleted
    // rather than left orphaned: `contentType.matches('image/.*')` accepts a
    // client-declared `image/svg+xml`, and Firebase serves stored bytes with
    // their declared type — so a re-introduced returns path where an admin views
    // photos inline would be a stored-XSS vector into an admin session. If
    // returns ever come back, add the rule back WITHOUT admin inline rendering
    // of buyer-uploaded files, or restrict contentType to raster images only.
  }
}
